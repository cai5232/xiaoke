# Copy this file to .env and replace all placeholder values.
XIAOKE_API_KEY=choose-a-long-random-secret
XIAOKE_UPSTREAM_URL=https://your-openai-compatible-upstream/v1
XIAOKE_UPSTREAM_KEY=paste-your-upstream-key-here
XIAOKE_UPSTREAM_TIMEOUT=120
XIAOKE_DEFAULT_MODEL=claude-sonnet-4.5
XIAOKE_DB_PATH=data/xiaoke.sqlite
PORT=3010
MAX_HANDOFF_RECORDS=20
MAX_HANDOFF_CHARS=24000

# Drive engine: per-message emotion scoring.
# Leave DRIVES_MODEL empty to skip the model call and use keyword rules only.
# DRIVES_BASE_URL / DRIVES_API_KEY default to the xiaoke upstream when unset.
DRIVES_MODEL=[按量6] claude-sonnet-4.5 [不补]
DRIVES_BASE_URL=
DRIVES_API_KEY=
DRIVES_TIMEOUT=8

# Reverie mailbox push target
REVERIE_PUSH_SESSION=reverie-yy
